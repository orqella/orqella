{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Privileged commands for the bundled local onboarding/settings page in the main window. The remote dashboard URL is not a local app URL, so it cannot use these commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-desktop-status",
    "allow-local-link-status",
    "allow-begin-local-link-login",
    "allow-poll-local-link-login",
    "allow-sign-out-local-link",
    "allow-connect-local",
    "allow-begin-link-login",
    "allow-poll-link-login",
    "allow-list-machines",
    "allow-connect-link-machine",
    "allow-disconnect-session",
    "allow-test-notification",
    "allow-diagnostics",
    "allow-export-diagnostics",
    "allow-sign-out",
    "allow-check-updates",
    "allow-install-update",
    "allow-saved-hubs",
    "allow-list-downloads",
    "allow-close-settings",
    "allow-updater-configured"
  ]
}
