{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Privileged capability for the bundled Orqella settings window.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-desktop-status",
    "allow-local-link-status",
    "allow-begin-local-link-login",
    "allow-poll-local-link-login",
    "allow-sign-out-local-link",
    "allow-connect-local",
    "allow-begin-link-login",
    "allow-poll-link-login",
    "allow-list-machines",
    "allow-connect-link-machine",
    "allow-disconnect-session",
    "allow-test-notification",
    "allow-diagnostics",
    "allow-export-diagnostics",
    "allow-sign-out",
    "allow-check-updates",
    "allow-install-update",
    "allow-saved-hubs",
    "allow-list-downloads"
  ]
}
