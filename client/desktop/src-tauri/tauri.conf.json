{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orqella Desktop",
  "version": "0.2.3",
  "identifier": "io.orqella.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "orqella"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFNThENTFDQTMwRjczNkIKUldScmN3K2pITlZZbmtlem9vTUtEWXVEVGt3YUE1VStqV3VPN1dmRWJNZEFoWkxUR2RQaHlzUjgK",
      "endpoints": [
        "https://orqella.io/desktop/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Orqella desktop client",
    "longDescription": "A native desktop client for Orqella: local-first modules, apps, terminals, and machines.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
